GROQ_API_KEY=gsk_вставь_сюда
# Цепочки моделей через запятую: если первая недоступна, берётся следующая
GROQ_VISION_MODELS=qwen/qwen3.8-27b
GROQ_TEXT_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Если на сервере 403 Forbidden — Groq блокирует IP, нужен прокси:
# GROQ_PROXY=http://user:pass@host:port

# Несколько ключей Groq через запятую. При лимите (429) берётся следующий.
# ВАЖНО: лимиты общие на весь аккаунт/организацию — ключи должны быть с РАЗНЫХ аккаунтов Groq.
# GROQ_API_KEYS=gsk_первый,gsk_второй,gsk_третий

# Вход на сервис. Формат логин:пароль через запятую. Пусто = без пароля (только для разработки!)
AUTH_USERS=admin:смените_пароль
# Секрет подписи сессий (любая длинная случайная строка), иначе при рестарте все разлогиниваются
AUTH_SECRET=
# Сколько документов распознавать одновременно (остальные ждут в очереди)
MAX_CONCURRENT=1
