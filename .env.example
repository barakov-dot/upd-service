GROQ_API_KEY=gsk_вставь_сюда
# Цепочки моделей через запятую: если первая недоступна, берётся следующая
GROQ_VISION_MODELS=qwen/qwen3.8-27b
GROQ_TEXT_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Если на сервере 403 Forbidden — Groq блокирует IP, нужен прокси:
# GROQ_PROXY=http://user:pass@host:port
